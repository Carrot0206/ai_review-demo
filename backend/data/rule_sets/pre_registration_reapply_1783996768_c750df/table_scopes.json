    {
      "scope_id": "PREG-SCOPE-004",
      "registration_type": "重新申请预登记",
      "source_file": "重新申请预登记审查规则_导入版.xlsx",
      "source_sheet": "表级报送范围",
      "source_row": 5,
      "table_name": "底层资产及交易对手",
      "scope_type": "conditional",
      "applicability_condition": {
        "logic": "OR",
        "conditions": [
          {
            "field": "业务分类信息.信托业务分类",
            "op": "equals",
            "value": "资产管理信托"
          },
          {
            "logic": "AND",
            "conditions": [
              {
                "field": "业务分类信息.资产服务信托分类2",
                "op": "in",
                "values": [
                  "法人及非法人组织财富管理信托",
                  "其他行政管理服务信托"
                ]
              },
              {
                "field": "底层资产及交易对手.底层资产（一类）",
                "op": "in",
                "values": [
                  "非标准化债权类资产",
                  "特定资产收（受）益权",
                  "股权/合伙企业份额类"
                ]
              }
            ]
          }
        ]
      },
      "exemption_condition": {
        "logic": "AND",
        "conditions": [
          {
            "field": "业务分类信息.信托业务分类",
            "op": "not_equals",
            "value": "资产管理信托"
          },
          {
            "field": "业务分类信息.资产服务信托分类2",
            "op": "not_in",
            "values": [
              "法人及非法人组织财富管理信托",
              "其他行政管理服务信托"
            ]
          }
        ]
      },
      "ai_materials": [
        "申报模板",
        "申请书"
      ],
      "ai_check_focus": "判断法人及非法人组织财富管理信托、其他行政管理服务信托是否涉及非标准化债权类资产、特定资产收（受）益权或股权/合伙企业份额；重点检查委托人及财产来源、交易结构简介和申请书。",
      "effective_from": "",
      "effective_to": "",
      "outside_effect": "unknown",
      "unknown_policy": "ai_review",
      "rule_text": "本表报送受托资金的拟投向范围，或拟受托财产（权）的基本属性。资产管理信托必填。法人及非法人组织财富管理信托、其他行政管理服务信托中涉及到非标准化债权类资产、特定资产收（受）益权、股权/合伙企业份额类的，应当填写。其他情形可豁免填写。",
      "basis_text": "附件1《预登记要素表及填表说明》— 数据结构",
      "risk_level": "高风险",
      "enabled": true
    },
