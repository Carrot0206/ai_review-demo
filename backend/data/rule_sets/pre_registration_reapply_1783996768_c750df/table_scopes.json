      "source_sheet": "表级报送范围",
      "source_row": 8,
      "table_name": "房地产项目信息",
      "scope_type": "conditional",
      "applicability_condition": {
        "logic": "OR",
        "conditions": [
          {
            "op": "table_has_content",
            "table": "房地产项目信息"
          },
          {
            "field": "底层资产及交易对手.项目融资信息",
            "op": "contains",
            "value": "房地产项目"
          },
          {
            "field": "底层资产及交易对手.合伙企业投向",
            "op": "contains",
            "value": "用于房地产项目建设"
          },
          {
            "field": "交易结构.交易结构简介",
            "op": "contains_any",
            "values": [
              "房地产项目",
              "房地产开发项目"
            ]
          }
        ]
      },
      "exemption_condition": {
        "field": "底层资产及交易对手.项目融资信息",
        "op": "equals",
        "value": "不适用"
      },
      "ai_materials": [
        "申报模板",
        "申请书"
      ],
      "ai_check_focus": "判断信托资金是否实际用于房地产项目。项目融资信息是主要依据；投向房地产业、不动产等仅是辅助信号，必须结合交易结构和申请书确认。",
      "effective_from": "",
      "effective_to": "",
      "outside_effect": "unknown",
      "unknown_policy": "ai_review",
      "rule_text": "资金运用涉及房地产项目的需要填报本表。",
      "basis_text": "附件1《预登记要素表及填表说明》— 数据结构及预登记要素表",
